&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};

// &led0 {
// 	gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
// };
&wdt {
	status = "okay";
};

&rtc0 {
	status="okay";
};
